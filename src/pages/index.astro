---
import Banner from '../components/sections/Banner.astro';
import Catalog from '../components/sections/Catalog.astro';
import Collections from '../components/sections/Collections.astro';
import Contact from '../components/sections/Contact.astro';
import Features from '../components/sections/Features.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Journey from '../components/sections/Journey.astro';
import Location from '../components/sections/Location.astro';
import Layout from '../layouts/Layout.astro';

// EDITA ESTOS DATOS ANTES DE PUBLICAR. Los ejemplos no son datos de un comercio real.
const DEFAULT_STORE = {
  whatsapp: '',
  email: '',
  address: '',
  hours: '',
  city: 'La Paz, Bolivia',
  usdRate: 6.96,
};
---

<Layout defaultStore={DEFAULT_STORE}>
  <Hero />
  <Features />
  <Collections />
  <Intro />
  <Catalog />
  <Banner />
  <Journey />
  <Location />
  <Contact />
</Layout>
