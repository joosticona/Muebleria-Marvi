---
const {
  as,
  href,
  variant,
  block = false,
  class: className = '',
  id,
  type = 'button',
  ...rest
} = Astro.props;

const isAnchor = as === 'a' || Boolean(href);
const classes = [
  'btn',
  variant ? `btn-${variant}` : '',
  block ? 'block' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{isAnchor ? (
  <a href={href} class={classes} id={id} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} id={id} type={type} {...rest}>
    <slot />
  </button>
)}
