---
import Icon from '../common/Icon.astro';

const features = [
  {
    icon: 'spark',
    title: 'Estilo que inspira',
    description: 'Diseños pensados para cada ambiente.',
  },
  {
    icon: 'ruler',
    title: 'Detalles que importan',
    description: 'Acabados, materiales y funcionalidad.',
  },
  {
    icon: 'truck',
    title: 'Compra a tu manera',
    description: 'Consulta disponibilidad y entrega.',
  },
];
---

<section class="features">
  <div class="shell features-grid">
    {features.map((item) => (
      <div class="feature">
        <Icon name={item.icon} />
        <div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
