---
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
---

<div inert class="overlay modal-shell" id="quickOverlay" aria-hidden="true">
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="quickTitle"
  >
    <button
      class="modal-close"
      type="button"
      data-close="quickOverlay"
      aria-label="Cerrar detalle"
    >
      <Icon name="close" />
    </button>
    <div class="quick-layout">
      <div class="quick-photo">
        <img id="quickImage" alt="" width="760" height="760" />
      </div>
      <div class="quick-info">
        <p class="eyebrow" id="quickCategory">
          Colección MARVI
        </p>
        <h2 id="quickTitle"></h2>
        <div class="quick-price" id="quickPrice"></div>
        <p class="quick-desc" id="quickDescription"></p>
        <p class="quick-attribute">
          <strong>Materiales:</strong>
          <span id="quickMaterial"></span>
        </p>
        <p class="quick-attribute">
          <strong>Medidas de ejemplo:</strong>
          <span id="quickDimensions"></span>
        </p>
        <p class="quick-attribute">
          Consulta disponibilidad, tapices y variantes antes de confirmar.
        </p>
        <Button variant="dark" block type="button" id="quickAdd">
          Añadir al carrito <Icon name="bag" />
        </Button>
      </div>
    </div>
  </div>
</div>
