{
  "name": "marvi-muebleria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "deploy": "astro build && wrangler pages deploy dist --project-name muebleria-marvi --branch main",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2"
  },
  "dependencies": {
    "astro": "7.4.1"
  }
}
